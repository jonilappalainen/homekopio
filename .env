
# this is the root dir that is being copied
SOURCE_DIR=$HOME/
# This the encrypted dir after init it should contain the gocryptfs.conf file
ENCRYPTED_DIR=/run/media/bob/usbstick
USE_GOCRYPT=true
# this should be an empty dir which is used to mount the backup dir
# This is where you can copy files
MOUNT_DIR=/tmp/backup

INCLUDES_FILE=${SCRIPT_DIR}/files
EXCLUDES_FILE=${SCRIPT_DIR}/excludes
